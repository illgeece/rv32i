Tier 0 functional verification: byte/halfword load-store (all 4 byte lanes + both halfword lanes), JALR bit-0 clearing, HINT no-op. No traps in this test.
m4_define(['m4_asm_ECALL'],  ['32'b00000000000000000000000001110011'])
m4_define(['m4_asm_EBREAK'], ['32'b00000000000100000000000001110011'])
m4_define(['m4_asm_MRET'],   ['32'b00110000001000000000000001110011'])
m4_asm(ADDI, x1, x0, 0)                      //  0  x1 = 0 (dmem base addr)
m4_asm(ADDI, x2, x0, 10000001)               //  4  x2 = 0x81 (129)
m4_asm(SB,   x1, x2, 0)                      //  8  mem byte0 = 0x81
m4_asm(ADDI, x2, x0, 10)                     // 12  x2 = 0x02 (2)
m4_asm(SB,   x1, x2, 1)                      // 16  mem byte1 = 0x02
m4_asm(ADDI, x2, x0, 10000011)               // 20  x2 = 0x83 (131)
m4_asm(SB,   x1, x2, 10)                     // 24  mem byte2 = 0x83
m4_asm(ADDI, x2, x0, 10000100)               // 28  x2 = 0x84 (132)
m4_asm(SB,   x1, x2, 11)                     // 32  mem byte3 = 0x84

m4_asm(LB,   x6,  x1, 0)                     // 36  x6  = sext(0x81)
m4_asm(LB,   x7,  x1, 1)                     // 40  x7  = sext(0x02)
m4_asm(LB,   x8,  x1, 10)                    // 44  x8  = sext(0x83)
m4_asm(LB,   x9,  x1, 11)                    // 48  x9  = sext(0x84)
m4_asm(LBU,  x10, x1, 0)                     // 52  x10 = zext(0x81)
m4_asm(LBU,  x11, x1, 10)                    // 56  x11 = zext(0x83)
m4_asm(LH,   x12, x1, 0)                     // 60  x12 = sext(halfword @0)
m4_asm(LH,   x13, x1, 10)                    // 64  x13 = sext(halfword @2)
m4_asm(LHU,  x14, x1, 0)                     // 68  x14 = zext(halfword @0)
m4_asm(LHU,  x15, x1, 10)                    // 72  x15 = zext(halfword @2)
m4_asm(LW,   x16, x1, 0)                     // 76  x16 = word0

m4_asm(ADDI, x2, x0, 1010101011)             // 80  x2 = 0x2AB (683)
m4_asm(SH,   x1, x2, 100)                    // 84  mem halfword @4 = 0x02AB
m4_asm(ADDI, x2, x0, 101010101)              // 88  x2 = 0x155 (341)
m4_asm(SH,   x1, x2, 110)                    // 92  mem halfword @6 = 0x0155  -> word1 = 0x015502AB
m4_asm(LW,   x17, x1, 100)                   // 96  x17 = word1

m4_asm(ADDI, x18, x0, 1101100)               // 100 x18 = 108 (landing pad addr)
m4_asm(JALR, x19, x18, 1)                    // 104 link=108; target=(108+1)&~1=108 (bit0 cleared)
m4_asm(ADDI, x20, x0, 1)                     // 108 landing pad reached -> x20=1

m4_asm(ADDI, x0, x0, 101)                    // 112 HINT: ADDI x0,x0,5 -- must NOT trap
m4_asm(ADDI, x21, x0, 101010)                // 116 x21=42: proves the HINT above did not trap

m4_asm(BGE, x0, x0, 0)                       // 120 halt
m4_asm_end()


