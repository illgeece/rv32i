# Verification scratch — regenerated by any regression run (~44 MB)
verif/work/

# Simulation artifacts: register/memory dumps and the assembled image.
# dmem.out alone is 4.7 MB and changes every run.
*.out
imem.hex

# Python
__pycache__/
*.pyc

# Local editor/tool settings
.claude/

# Note: out/ is deliberately NOT ignored. It holds the SandPiper-generated
# SystemVerilog, and SandPiper is a hosted tool — committing the output lets
# anyone read the synthesisable RTL and run Verilator without an account.
